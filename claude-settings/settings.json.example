{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(Get-Item:*)",

      "PowerShell(.\\smoke-test.ps1:*)",
      "PowerShell(& .\\smoke-test.ps1:*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -NoProfile -File .\\smoke-test.ps1:*)",
      "Bash(./smoke-test.ps1:*)",
      "Bash(powershell -ExecutionPolicy Bypass -NoProfile -File ./smoke-test.ps1:*)"
    ],
    "deny": []
  }
}
